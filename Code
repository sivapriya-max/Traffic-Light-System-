```c
#include <stdio.h>

int main()
{
    int color;

    printf("Traffic Light System\n");
    printf("1. Red\n");
    printf("2. Yellow\n");
    printf("3. Green\n");

    printf("Enter your choice: ");
    scanf("%d", &color);

    switch(color)
    {
        case 1:
            printf("RED - STOP");
            break;

        case 2:
            printf("YELLOW - WAIT");
            break;

        case 3:
            printf("GREEN - GO");
            break;

        default:
            printf("Invalid choice");
    }

    return 0;
}
